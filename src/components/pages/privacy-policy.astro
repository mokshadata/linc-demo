---
import BaseLayout from "@layouts/BaseLayout.astro";
import GetStarted from "@components/GetStarted.astro";

import { getEntry } from "astro:content";

const { currentLocale } = Astro.props || 'en';

const privacyPolicySection = await getEntry('parts', `${currentLocale}/07-privacy-policy`)
const privacyPolicySectionWithContent = {
  ...privacyPolicySection,
  ...await privacyPolicySection?.render(),
}
---

<BaseLayout pageTitle={privacyPolicySectionWithContent.data?.page_title || 'Fort Bend LINC'} currentLocale={currentLocale}>
  <main data-page="index">
    <section class="title-section">
      <div class="container">
        <div class="grid">
          <div class="content intro">
            <h1>{privacyPolicySectionWithContent.data?.headline}</h1>
          </div>
        </div>
      </div>
    </section>
    <section class="about privacy-policy">
      <div class="container">
        <privacyPolicySectionWithContent.Content/>
      </div>
    </section>
    <GetStarted currentLocale={currentLocale}/>
  </main>
</BaseLayout>

<style>
.about :global(img) {
  display: block;
  padding-bottom: 3rem;
  margin: auto;
}

.emphasis {
  font-weight: 800;
  font-style: italic;
}

.about {
  padding: 4rem 0;
}
</style>